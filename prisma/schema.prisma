generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum OtpPurpose {
  SIGNUP
}

enum VerificationType {
  BVN
  NIN
  GOVERNMENT_ID
  LIVENESS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  dateOfBirth     DateTime   @map("date_of_birth") @db.Date
  pinHash         String?    @map("pin_hash")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  ladderId        String?    @unique @map("ladder_id")
  status          UserStatus @default(PENDING)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  verifications Verification[]
  sessions      Session[]

  @@map("users")
}

model Otp {
  id         String     @id @default(uuid())
  email      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([email, purpose])
  @@map("otps")
}

model Verification {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  type           VerificationType
  status         VerificationStatus @default(PENDING)
  valueEncrypted String?            @map("value_encrypted")
  last4          String?
  provider       String
  providerRef    String?            @map("provider_ref")
  failureReason  String?            @map("failure_reason")
  verifiedAt     DateTime?          @map("verified_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([userId, type])
  @@map("verifications")
}

model Document {
  id             String   @id @default(uuid())
  verificationId String   @map("verification_id")
  idType         String   @map("id_type")
  storageKey     String   @map("storage_key")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
