generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

// The onboarding page a user was last on, so signing back in returns them there.
enum OnboardingStep {
  CREDENTIALS
  UPLOAD_ID
  LIVENESS
}

enum OtpPurpose {
  SIGNUP
}

enum VerificationType {
  BVN
  NIN
  GOVERNMENT_ID
  LIVENESS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

// How a customer identified on a partner's assistance flow (ladder-assistance).
enum AssistanceMethod {
  BVN
  NIN
  BVN_AND_NIN
  LADDER_ID
}

// Why an assistance identify failed. The partner screen only ever shows one generic error; the
// reason is kept for the WhatsApp help chat, which explains it to the customer who typed it.
enum AssistanceIssueReason {
  NOT_FOUND
  INVALID
  DOB_MISMATCH
  // BVN and NIN each matched the date of birth but belong to different people.
  DIFFERENT_PEOPLE
  LADDER_ID_UNKNOWN
  // The Ladder ID exists but its owner has no verified BVN or NIN yet.
  LADDER_ID_NOT_VERIFIED
}

// Where a help issue stands, shown to agents on ladder-agent-dashboard.
enum AssistanceIssueStatus {
  // Logged on the failed identify.
  OPEN
  // The customer opened the help chat (web or WhatsApp).
  IN_CHAT
  // The customer is waiting for a person: retried 3+ times, asked for a human, the AI could not
  // answer, or wrote while an agent has the chat.
  NEEDS_ATTENTION
  ESCALATED
  // The same ID later passed identify, or an agent resolved it.
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String          @map("password_hash")
  dateOfBirth        DateTime?       @map("date_of_birth") @db.Date
  emailVerifiedAt    DateTime?       @map("email_verified_at")
  ladderId           String?         @unique @map("ladder_id")
  lastOnboardingStep OnboardingStep? @map("last_onboarding_step")
  status             UserStatus      @default(PENDING)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  verifications      Verification[]
  sessions           Session[]
  assistanceSessions AssistanceSession[]

  @@map("users")
}

model Otp {
  id         String     @id @default(uuid())
  email      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([email, purpose])
  @@map("otps")
}

model Verification {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  type           VerificationType
  status         VerificationStatus @default(PENDING)
  valueEncrypted String?            @map("value_encrypted")
  last4          String?
  // GOVERNMENT_ID only: which document was uploaded, e.g. "drivers-licence".
  documentType   String?            @map("document_type")
  provider       String
  providerRef    String?            @map("provider_ref")
  failureReason  String?            @map("failure_reason")
  verifiedAt     DateTime?          @map("verified_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("verifications")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Mock BVN/NIN registry used by RegistryIdentityProvider. Seeded by prisma/seed.ts.
model IdentityRecord {
  id                 String           @id @default(uuid())
  type               VerificationType
  number             String
  dateOfBirth        DateTime         @map("date_of_birth") @db.Date
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  isValid            Boolean          @map("is_valid")
  // Shown to partners after liveness (ladder-assistance "Your details").
  phoneNumber        String?          @map("phone_number")
  residentialAddress String?          @map("residential_address")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([type, number])
  @@map("identity_records")
}

// A customer's short-lived session on a partner's assistance flow. Created only after the identity
// matches. Holds no identity numbers: providerRef points at the provider's record for the details.
model AssistanceSession {
  id                 String           @id @default(uuid())
  tokenHash          String           @unique @map("token_hash")
  partnerId          String           @map("partner_id")
  method             AssistanceMethod
  providerRef        String           @map("provider_ref")
  // LADDER_ID only: the Ladder user, whose account email is shown.
  userId             String?          @map("user_id")
  livenessVerifiedAt DateTime?        @map("liveness_verified_at")
  confirmedAt        DateTime?        @map("confirmed_at")
  expiresAt          DateTime         @map("expires_at")
  revokedAt          DateTime?        @map("revoked_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assistance_sessions")
}

// A failed assistance identify, logged so the customer can get help in the chat (web or WhatsApp)
// and agents can follow it up. Retrying with the same details reuses the open issue.
model AssistanceIssue {
  id                 String                @id @default(uuid())
  reference          String                @unique
  partnerId          String                @map("partner_id")
  method             AssistanceMethod
  // BVN or NIN when one of them failed; null for Ladder IDs.
  failedType         VerificationType?     @map("failed_type")
  reason             AssistanceIssueReason
  // Only the last 4 characters of what was typed, e.g. *******8901.
  maskedValue        String                @map("masked_value")
  contactPhone       String?               @map("contact_phone")
  // Chosen in the help chat after Ladder's opening message, e.g. "Yoruba".
  preferredLanguage  String?               @map("preferred_language")
  // Until then an unclaimed reference can be claimed.
  expiresAt          DateTime              @map("expires_at")
  status             AssistanceIssueStatus @default(OPEN)
  // Failed identifies with exactly these details while the issue was open.
  attempts           Int                   @default(1)
  lastAttemptAt      DateTime              @default(now()) @map("last_attempt_at")
  // Keyed HMACs (never the numbers): of everything typed, and of the failed ID alone.
  attemptFingerprint String                @map("attempt_fingerprint")
  idFingerprint      String                @map("id_fingerprint")
  // attemptFingerprint while the issue is open, else null: one open issue per set of details.
  openFingerprint    String?               @unique @map("open_fingerprint")
  resolvedAt         DateTime?             @map("resolved_at")
  // "Automatic" when the ID later passed identify, else the agent's name.
  resolvedBy         String?               @map("resolved_by")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  messages WhatsAppMessage[]
  notes    AssistanceIssueNote[]

  @@index([contactPhone])
  @@index([idFingerprint])
  @@index([status, updatedAt])
  @@map("assistance_issues")
}

// An agent's note on a help issue (ladder-agent-dashboard).
model AssistanceIssueNote {
  id         String   @id @default(uuid())
  issueId    String   @map("issue_id")
  text       String
  authorName String   @map("author_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  issue AssistanceIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@map("assistance_issue_notes")
}

// Every WhatsApp message to or from a customer. Long numbers are masked before storing.
model WhatsAppMessage {
  id                String           @id @default(uuid())
  issueId           String?          @map("issue_id")
  direction         MessageDirection
  // The customer's number, E.164 (+234...).
  phone             String
  body              String
  // Infobip's messageId: repeated webhook deliveries are ignored, reports are matched by it.
  providerMessageId String?          @unique @map("provider_message_id")
  status            DeliveryStatus
  errorCode         String?          @map("error_code")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  issue AssistanceIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([issueId])
  @@map("whatsapp_messages")
}
