generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

// The onboarding page a user was last on, so signing back in returns them there.
enum OnboardingStep {
  CREDENTIALS
  UPLOAD_ID
  LIVENESS
}

enum OtpPurpose {
  SIGNUP
}

enum VerificationType {
  BVN
  NIN
  GOVERNMENT_ID
  LIVENESS
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

// How a customer identified on a partner's assistance flow (ladder-assistance).
enum AssistanceMethod {
  BVN
  NIN
  BVN_AND_NIN
  LADDER_ID
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  passwordHash       String          @map("password_hash")
  dateOfBirth        DateTime?       @map("date_of_birth") @db.Date
  emailVerifiedAt    DateTime?       @map("email_verified_at")
  ladderId           String?         @unique @map("ladder_id")
  lastOnboardingStep OnboardingStep? @map("last_onboarding_step")
  status             UserStatus      @default(PENDING)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  verifications      Verification[]
  sessions           Session[]
  assistanceSessions AssistanceSession[]

  @@map("users")
}

model Otp {
  id         String     @id @default(uuid())
  email      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  attempts   Int        @default(0)
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([email, purpose])
  @@map("otps")
}

model Verification {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  type           VerificationType
  status         VerificationStatus @default(PENDING)
  valueEncrypted String?            @map("value_encrypted")
  last4          String?
  // GOVERNMENT_ID only: which document was uploaded, e.g. "drivers-licence".
  documentType   String?            @map("document_type")
  provider       String
  providerRef    String?            @map("provider_ref")
  failureReason  String?            @map("failure_reason")
  verifiedAt     DateTime?          @map("verified_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("verifications")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Mock BVN/NIN registry used by RegistryIdentityProvider. Seeded by prisma/seed.ts.
model IdentityRecord {
  id                 String           @id @default(uuid())
  type               VerificationType
  number             String
  dateOfBirth        DateTime         @map("date_of_birth") @db.Date
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  isValid            Boolean          @map("is_valid")
  // Shown to partners after liveness (ladder-assistance "Your details").
  phoneNumber        String?          @map("phone_number")
  residentialAddress String?          @map("residential_address")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([type, number])
  @@map("identity_records")
}

// A customer's short-lived session on a partner's assistance flow. Created only after the identity
// matches. Holds no identity numbers: providerRef points at the provider's record for the details.
model AssistanceSession {
  id                 String           @id @default(uuid())
  tokenHash          String           @unique @map("token_hash")
  partnerId          String           @map("partner_id")
  method             AssistanceMethod
  providerRef        String           @map("provider_ref")
  // LADDER_ID only: the Ladder user, whose account email is shown.
  userId             String?          @map("user_id")
  livenessVerifiedAt DateTime?        @map("liveness_verified_at")
  confirmedAt        DateTime?        @map("confirmed_at")
  expiresAt          DateTime         @map("expires_at")
  revokedAt          DateTime?        @map("revoked_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("assistance_sessions")
}
