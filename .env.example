NODE_ENV=development
PORT=4000
# Origins of ladder-web and ladder-assistance allowed by CORS, comma-separated (e.g. http://localhost:3000,https://ladder.vercel.app)
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# Supabase session pooler (port 5432) for the app and for migrations. Do not use the transaction
# pooler (6543 + pgbouncer=true) for this long-running server: with Prisma every query took ~5x longer.
DATABASE_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres?connection_limit=5&connect_timeout=15&pool_timeout=20"
DIRECT_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres"

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=ladder_session
SESSION_TTL_HOURS=24
# lax for local dev; none when ladder-web is on another site (Vercel + Render)
COOKIE_SAME_SITE=lax

# BVN/NIN source: registry = mock records in the identity_records table
IDENTITY_PROVIDER=registry

# ladder-assistance: partners allowed (X-Partner-Id), comma-separated, and its session cookie
ASSISTANCE_PARTNER_IDS=zenith
ASSISTANCE_COOKIE_NAME=ladder_assistance_session

# Brevo transactional email (sender must be verified in Brevo)
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Ladder

# WhatsApp help chat for failed assistance identifies. console = log messages instead of sending.
WHATSAPP_PROVIDER=console
# Infobip (required when WHATSAPP_PROVIDER=infobip): Developer Tools → API keys
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
# WhatsApp sender, digits only
INFOBIP_WHATSAPP_SENDER=447860088970
# Secret you make up (openssl rand -hex 16). Infobip forwarding URL:
#   https://<backend>/api/v1/webhooks/infobip/inbound?token=<INFOBIP_WEBHOOK_TOKEN>
INFOBIP_WEBHOOK_TOKEN=
# This API's public URL without /api/v1 (for delivery reports); leave empty locally
PUBLIC_BASE_URL=

# Groq writes the WhatsApp replies; empty = a fixed explanation is sent instead
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
