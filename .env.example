NODE_ENV=development
PORT=4000
# Origins of ladder-web and ladder-assistance allowed by CORS, comma-separated (e.g. http://localhost:3000,https://ladder.vercel.app)
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# Supabase: pooled connection for the app, direct connection for migrations
DATABASE_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres"

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=ladder_session
SESSION_TTL_HOURS=24
# lax for local dev; none when ladder-web is on another site (Vercel + Render)
COOKIE_SAME_SITE=lax

# BVN/NIN source: registry = mock records in the identity_records table
IDENTITY_PROVIDER=registry

# ladder-assistance: partners allowed (X-Partner-Id), comma-separated, and its session cookie
ASSISTANCE_PARTNER_IDS=zenith
ASSISTANCE_COOKIE_NAME=ladder_assistance_session

# Brevo transactional email (sender must be verified in Brevo)
BREVO_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Ladder
