NODE_ENV=development
PORT=4000
# Origin of ladder-web (CORS + cookies)
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ladder?schema=public

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=ladder_session
SESSION_TTL_HOURS=24

# Identity vendor: mock (dev only) until a vendor is chosen
IDENTITY_PROVIDER=mock

# S3-compatible storage (private bucket)
S3_BUCKET=ladder-documents
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMTP for OTP emails (e.g. Mailpit locally on 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ladder <no-reply@ladder.local>"
